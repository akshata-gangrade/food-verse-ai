# Food Verse AI Backend Environment Configuration

# Security & JWT
SECRET_KEY=aahaar-super-secret-jwt-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database
# If MongoDB is not running locally, Food Verse AI automatically falls back to an in-memory database
MONGODB_URL=mongodb://localhost:27017
DATABASE_NAME=aahaar_ai

# Google Gemini AI Configuration
# Leave GEMINI_API_KEY blank to run in Demo Mode with realistic sample responses
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
DEMO_MODE=true

# Cross-Origin Resource Sharing
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
